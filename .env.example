# Copy this file to .env
# 1 for local development, 0 when deployed
DEBUG=1
# Required when DEBUG=0. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
# Comma separated, used when deployed, e.g. yourname.com,www.yourname.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Needed behind HTTPS when deployed, e.g. https://yourname.com
CSRF_TRUSTED_ORIGINS=

# Used by `python manage.py seed` to create your admin login.
# Leave ADMIN_PASSWORD empty to be asked for it in the terminal instead (safer).
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
